{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://next-cricket-985.convex.cloud" }
    },
    "release-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://next-cricket-985.convex.cloud" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://next-cricket-985.convex.cloud" }
    }
  }
}
